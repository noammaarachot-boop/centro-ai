# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local embedded database (PGlite dev fallback, see src/db/index.ts)
/.centro-data/

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch E2E test fixtures (synthetic "TEST DOCUMENT ONLY" PDFs/images for
# manual end-to-end testing) and their one-off generator scripts — never
# meant to be committed; see scripts/_e2e_make_fixtures*.mjs
/scratch_e2e_fixtures/
/scratch_e2e_fixtures_he/
scripts/_e2e_*.mjs

# Responsive smoke-test artifacts (regenerated by `npm run test:responsive`)
e2e/screenshots/
.tmp-e2e-pgdata/
